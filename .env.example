# Copie para .env e preencha UMA das chaves abaixo (a outra pode ficar como está)

# Gemini API (Google): tem plano gratuito, sem cartão. Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui
# Opcional: modelo do Gemini (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# Claude API (Anthropic): paga por uso
ANTHROPIC_API_KEY=sua-chave-aqui
# Opcional: modelo e esforço de raciocínio (low | medium | high)
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium

# Opcional: força um provedor (gemini | claude). Sem isso, o Gemini tem prioridade.
# PROVEDOR=gemini
